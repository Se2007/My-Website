---
import Base from '../layouts/Base.astro';

import { getCollection } from 'astro:content';

const achievements = (await getCollection('achievements', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const publications = (await getCollection('publications', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.year) - Number(a.data.year))
  .slice(0, 3);

const blogPosts = (await getCollection('blogs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Home">

  <!-- Hero -->
  <div class="hero">
    <div class="hero-text">
      <h1><span class="first-name">Sepehr</span> Eslami Moghadam</h1>
      <p>
        Persian with proud, and a self-taught maker who builds and breaks
        boundaries in computer science, with the spirit of an experimental
        engineer who is passionate about the practical side of bringing AI to
        the real world. From theory to deployment. Currently obsessed with
        deep neural networks, medical computer vision, and machine learning
        reinforcement systems.
      </p>
      <div class="social-links">
        <a href="mailto:your@email.com">Email</a>
        <a href="https://github.com/Se2007" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://scholar.google.com/citations?user=yourid" target="_blank" rel="noopener">Scholar</a>
        <a href="https://kaggle.com/sepehreslamimoghadam" target="_blank" rel="noopener">Kaggle</a>
        <a href="https://huggingface.co/yourusername" target="_blank" rel="noopener">HuggingFace</a>
        <a href="https://medium.com/@sepehr.eslami2019" target="_blank" rel="noopener">Medium</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/profile.jpg" alt="Sepehr Eslami Moghadam" />
    </div>
  </div>

  <!-- Achievements -->
  <section>
    <div class="section-header">
      <h2>Achievements</h2>
      <a href="/achievements">See all →</a>
    </div>
    <div class="ach-list">
      {achievements.map(item => {
          const year = new Date(item.data.date).getFullYear();
          return (
            <a href={`/achievements/${item.slug}`} class="ach-item">
              <span class="ach-year">{year}</span>
              <div>
                <p class="ach-title">{item.data.title}</p>
                {item.data.description && (
                  <p class="ach-desc">{item.data.description}</p>
                )}
              </div>
            </a>
          );
        })}
    </div>
  </section>

  <!-- Projects -->
  <section>
    <div class="section-header">
      <h2>Projects</h2>
      <a href="/projects">See all →</a>
    </div>
    <div class="grid-3">
      {projects.map(project => (
        <a href={`/projects/${project.slug}`} class="card">
          {project.data.banner
            ? <img src={project.data.banner} alt={project.data.title} class="card-img" />
            : <div class="card-img-empty" />
          }
          <div class="card-body">
            <p class="card-title">{project.data.title}</p>
            <p class="card-desc">{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Blog -->
  <section>
    <div class="section-header">
      <h2>Latest Posts</h2>
      <a href="/blogs">See all →</a>
    </div>
    <div class="pub-list">
      {blogPosts.map(post => (
        <a href={`/blogs/${post.slug}`} class="pub-item">
          <span class="pub-year">
            {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </span>
          <div>
            <p class="pub-title">{post.data.title}</p>
            <p class="pub-venue">{post.data.description}</p>
          </div>
          {post.data.link && <span class="badge badge-medium">Medium</span>}
        </a>
      ))}
    </div>
  </section>

</Base>
<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4rem;
    padding: 5rem 0 4rem;
    margin-bottom: 5rem;
  }

  .hero-text { flex: 1; }

  .hero-text h1 {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .first-name {
    font-weight: 700;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    font-size: 0.92rem;
    font-weight: 500;
    padding: 7px 18px;
    border-radius: 24px;
    border: 1.5px solid var(--border);
    color: var(--secondary);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.15s;
  }

  .social-links a:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--tag-bg);
    transform: translateY(-2px);
  }

  .hero-text p {
    font-size: 1.35rem;
    line-height: 2;
    color: var(--secondary);
    max-width: 750px;
  }

  .hero-image img {
    width: 290px;
    height: 290px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    filter: grayscale(20%);
  }

  /* Sections */
  section {
    margin-bottom: 5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .section-header a {
    font-size: 0.8rem;
    color: var(--secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .section-header a:hover { color: var(--primary); }

  /* Achievements */
  .ach-list {
    display: flex;
    flex-direction: column;
  }

  .ach-item, .ach-item * {
  text-decoration: none !important;
}

  .ach-item {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.25s ease, opacity 0.25s ease;
    cursor: pointer;
  }

  .ach-item:hover {
    padding-left: 0.75rem;
    opacity: 0.75;
  }

  .ach-item:first-child {
    border-top: 1px solid var(--border);
  }

  .ach-year {
    font-size: 0.85rem;
    color: var(--secondary);
    min-width: 40px;
    padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }

  .ach-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--primary);
    transition: color 0.2s;
  }

  .ach-item:hover .ach-title {
    color: var(--link-hover);
  }

  .ach-desc {
    font-size: 0.95rem;
    color: var(--secondary);
    line-height: 1.6;
  }

  /* Grid */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Cards */
  .card {
    text-decoration: none;
    color: inherit;
    display: block;
    background: var(--entry);
    transition: background 0.2s, transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .card:hover {
    background: var(--tag-bg);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    z-index: 1;
  }

  .card-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
    filter: grayscale(15%);
    transition: filter 0.3s, transform 0.3s ease;
  }

  .card:hover .card-img {
    filter: grayscale(0%);
    transform: scale(1.04);
  }

  .card-img-empty {
    width: 100%;
    height: 160px;
    background: var(--border);
  }

  .card-body {
    padding: 1.25rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--secondary);
    line-height: 1.6;
  }

  /* Publications */
  .pub-list {
    display: flex;
    flex-direction: column;
  }

  .pub-item {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.25rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
    transition: background 0.2s, padding-left 0.25s;
  }

  .pub-item:first-child { border-top: 1px solid var(--border); }
  .pub-item:hover { background: var(--tag-bg); padding-left: 1.25rem; }

  .pub-year {
    font-size: 0.85rem;
    color: var(--secondary);
    min-width: 40px;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .pub-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
    color: var(--primary);
  }

  .pub-venue {
    font-size: 0.85rem;
    color: var(--secondary);
    font-style: italic;
  }

  .badge {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-left: auto;
  }

  .badge-journal    { background: rgba(59,130,246,0.12); color: #60a5fa; }
  .badge-conference { background: rgba(16,185,129,0.12); color: #34d399; }
  .badge-preprint   { background: rgba(245,158,11,0.12);  color: #fbbf24; }
  .badge-medium     { background: rgba(255,255,255,0.08); color: var(--secondary); }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column-reverse;
      align-items: center;
      gap: 2rem;
      padding: 2rem 0;
    }
    .hero-text h1 { font-size: 2rem; }
    .hero-image img { width: 180px; height: 180px; }
    .grid-3 { grid-template-columns: 1fr; }
  }
</style>