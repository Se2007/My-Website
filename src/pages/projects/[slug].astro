---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const { title, description, date, banner, github, demo, tags } = item.data;

const formatted = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base title={title} description={description}>
  <article class="project-container">

    {banner && (
      <div class="main-banner">
        <img src={banner} alt={title} class="banner-img" />
      </div>
    )}

    <header>
      <h1>{title}</h1>
      <time>{formatted}</time>

      <div class="links">
        {github && (
          <a href={github} target="_blank" rel="noopener" class="btn">GitHub</a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener" class="btn btn-outline">Live Demo</a>
        )}
      </div>

      {tags && (
        <div class="tags">
          {tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="content">
      <Content />
    </div>

    <a href="/projects" class="back">← All projects</a>
  </article>
</Base>

<style>
  .project-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  /* banner style is handled globally via .banner-img in global.css */

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  header time {
    font-size: 0.85rem;
    color: var(--secondary);
    display: block;
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .btn {
    font-size: 0.9rem;
    padding: 6px 16px;
    border-radius: 6px;
    text-decoration: none;
    background: var(--primary);
    color: var(--theme);
    transition: opacity 0.2s;
  }

  .btn:hover { opacity: 0.8; }

  .btn-outline {
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.75rem;
    background: var(--tag-bg);
    color: var(--tag-color);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .content {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
  }

  .content h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--primary);
  }

  .content p {
    margin-bottom: 1.5rem;
  }

  .content ul, .content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .content li {
    margin-bottom: 0.6rem;
    line-height: 1.7;
  }

  .content strong {
    font-weight: 600;
    color: var(--primary);
  }

  .content code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.85em;
    background: var(--tag-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .content blockquote {
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--secondary);
    font-style: italic;
    margin: 1.5rem 0;
  }

  .back {
    display: inline-block;
    margin-top: 4rem;
    font-size: 0.95rem;
    color: var(--secondary);
    text-decoration: none;
  }

  .back:hover {
    color: var(--primary);
  }
</style>