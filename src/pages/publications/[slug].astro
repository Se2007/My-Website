---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const publications = await getCollection('publications', ({ data }) => !data.draft);
  return publications.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const { title, authors, venue, year, type, banner, pdf, arxiv, doi, code, demo } = item.data;

const myName = 'Sepehr Eslami Moghadam';

const typeLabel: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  preprint: 'Preprint',
};
---

<Base title={title}>
  <article class="pub-container">

    {banner && (
      <div class="main-banner">
        <img src={banner} alt={title} />
      </div>
    )}

    <header>
      <span class={`badge badge-${type}`}>{typeLabel[type]}</span>
      <h1>{title}</h1>
      <p class="authors" set:html={authors.replace(myName, `<strong>${myName}</strong>`)} />
      {venue && <p class="venue">{venue}, {year}</p>}

      <div class="links">
        {pdf   && <a href={pdf}   target="_blank" class="btn">PDF</a>}
        {arxiv && <a href={arxiv} target="_blank" class="btn">arXiv</a>}
        {doi   && <a href={doi}   target="_blank" class="btn btn-outline">DOI</a>}
        {code  && <a href={code}  target="_blank" class="btn btn-outline">Code</a>}
        {demo  && <a href={demo}  target="_blank" class="btn btn-outline">Demo</a>}
      </div>
    </header>

    <div class="content">
      <Content />
    </div>

    <a href="/publications" class="back">← All publications</a>
  </article>
</Base>

<style>
  .pub-container { max-width: 1000px; margin: 0 auto; padding: 2rem 0; }

  .main-banner img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .badge-journal    { background: rgba(59,130,246,0.12); color: #60a5fa; }
  .badge-conference { background: rgba(16,185,129,0.12); color: #34d399; }
  .badge-preprint   { background: rgba(245,158,11,0.12);  color: #fbbf24; }

  header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem; line-height: 1.3; }

  .authors { font-size: 0.95rem; color: var(--secondary); margin-bottom: 0.25rem; }
  .authors strong { color: var(--primary); font-weight: 600; }

  .venue { font-size: 0.9rem; font-style: italic; color: var(--secondary); margin-bottom: 1.25rem; }

  .links { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .btn {
    font-size: 0.9rem;
    padding: 6px 16px;
    border-radius: 6px;
    text-decoration: none;
    background: var(--primary);
    color: var(--theme);
    transition: opacity 0.2s;
  }

  .btn:hover { opacity: 0.8; }

  .btn-outline {
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border);
  }

  .content { font-size: 1.1rem; line-height: 1.8; }
  .content h2 { font-size: 1.5rem; font-weight: 600; margin: 2.5rem 0 1rem; }
  .content p { margin-bottom: 1.5rem; }

  .back {
    display: inline-block;
    margin-top: 4rem;
    font-size: 0.95rem;
    color: var(--secondary);
    text-decoration: none;
  }

  .back:hover { color: var(--primary); }
</style>