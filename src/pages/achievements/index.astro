---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const achievements = (await getCollection('achievements', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Achievements">
  <h1>Achievements</h1>

  <div class="list">
    {achievements.map(item => {
      const year = new Date(item.data.date).getFullYear();
      return (
        <a href={`/achievements/${item.slug}`} class="item">
          <span class="year">{year}</span>
          <div class="content">
            <p class="title">{item.data.title}</p>
            {item.data.description && (
              <p class="desc">{item.data.description}</p>
            )}
          </div>
          <span class="arrow">→</span>
        </a>
      );
    })}
  </div>
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .item {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .item:first-child { border-top: 1px solid var(--border); }
  .item:hover { opacity: 0.7; }

  .year {
    font-size: 0.85rem;
    color: var(--secondary);
    min-width: 40px;
  }

  .content { flex: 1; }

  .title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .desc {
    font-size: 0.85rem;
    color: var(--secondary);
  }

  .arrow {
    color: var(--border);
    font-size: 1rem;
  }

  .item:hover .arrow { color: var(--primary); }
</style>