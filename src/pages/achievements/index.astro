---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('achievements', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by category — fallback to "General" if category is missing
const categoryMap = new Map<string, typeof projects>();
for (const p of projects) {
  const cat = p.data.category ?? 'General';
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat)!.push(p);
}
const categories = [...categoryMap.entries()];
---

<Base title="Achievements">
  <h1>Achievements</h1>

  {projects.length === 0 && (
    <p style="color: var(--secondary)">No achievements found.</p>
  )}

  {categories.map(([category, items]) => (
    <div class="category-section">
      <div class="category-label">{category}</div>
      <div class="grid">
        {items.map(project => (
          <a href={`/achievements/${project.slug}`} class="card">
            {project.data.banner && (
              <div class="card-image">
                <img src={project.data.banner} alt={project.data.title} />
              </div>
            )}
            <div class="card-body">
              <h2>{project.data.title}</h2>
              <p>{project.data.description}</p>
              {project.data.tags && (
                <div class="tags">
                  {project.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
  }

  .category-section {
    margin-bottom: 3rem;
  }

  .category-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--secondary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, opacity 0.2s;
  }

  .card:hover {
    border-color: var(--primary);
    opacity: 0.85;
  }

  .card-image img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-body h2 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .card-body p {
    font-size: 0.82rem;
    color: var(--secondary);
    margin: 0;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    background: var(--border);
    color: var(--secondary);
  }
</style>