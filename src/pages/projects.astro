---
import Base from '../layouts/Base.astro';

const projects = [
  {
    title: 'Project 1',
    description: 'Short description of the project.',
    image: '/projects/project1.jpg',
    link: 'https://github.com/yourusername/project1',
    category: 'work',
  },
  {
    title: 'Project 2',
    description: 'Short description of the project.',
    image: '/projects/project2.jpg',
    link: 'https://github.com/yourusername/project2',
    category: 'work',
  },
  {
    title: 'Project 3',
    description: 'Short description of the project.',
    image: null,
    link: 'https://github.com/yourusername/project3',
    category: 'fun',
  },
];

const categories = [...new Set(projects.map(p => p.category))];
---

<Base title="Projects">
  <h1>Projects</h1>
  <p class="subtitle">A growing collection of my projects.</p>

  {categories.map(category => (
    <div class="category-section">
      <div class="category-label">{category}</div>
      <div class="grid">
        {projects.filter(p => p.category === category).map(project => (
          <a href={project.link} target="_blank" rel="noopener" class="card">
            {project.image && (
              <div class="card-image">
                <img src={project.image} alt={project.title} />
              </div>
            )}
            <div class="card-body">
              <h2>{project.title}</h2>
              <p>{project.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--secondary);
    margin-bottom: 3rem;
  }

  .category-section {
    margin-bottom: 3rem;
  }

  .category-label {
    text-align: right;
    font-size: 1.1rem;
    color: var(--border);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }

  .card:hover {
    border-color: var(--secondary);
  }

  .card-image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.25rem;
  }

  .card-body h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-body p {
    font-size: 0.9rem;
    color: var(--secondary);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>