---
import Base from '../layouts/Base.astro';
---

<Base title="404 – Page Not Found">
  <div style="text-align: center; padding: 4rem 0;">
    <h1 style="font-size: 4rem; font-weight: 700; color: var(--border); margin-bottom: 1rem;">404</h1>
    <p style="color: var(--secondary); margin-bottom: 2rem;">This page doesn't exist.</p>
    <a
      href="/"
      style="color: var(--primary); text-decoration: none; border: 1px solid var(--border); padding: 8px 20px; border-radius: 4px;"
    >
      ← Back to home
    </a>
  </div>
</Base>
