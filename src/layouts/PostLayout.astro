---
import Base from './Base.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, author, minutesRead } = post.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {minutesRead && <span>{minutesRead} min read</span>}
        <span>· {author}</span>
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => (
            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="article-content">
      <slot />
    </div>

    <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
      <a href="/" style="color: var(--secondary); text-decoration: none; font-size: 0.9rem;">
        ← Back to home
      </a>
    </footer>
  </article>
</Base>
